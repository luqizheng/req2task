{
  "name": "@req2task/ai-chat-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "db:create": "tsx src/scripts/create-database.ts",
    "db:drop": "tsx src/scripts/drop-database.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/database/data-source.ts",
    "migration:drop": "pnpm build && pnpm typeorm schema:drop -d ./dist/database/data-source.js"
  },
  "dependencies": {
    "@langchain/anthropic": "^0.2.0",
    "@langchain/community": "^0.2.0",
    "@langchain/core": "^0.2.36",
    "@langchain/ollama": "^0.2.0",
    "@langchain/openai": "^0.2.11",
    "@req2task/dto": "workspace:^",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "cors": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:",
    "langchain": "^0.2.20",
    "mammoth": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "reflect-metadata": "catalog:",
    "typeorm": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
