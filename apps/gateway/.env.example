# Gateway 配置
NODE_ENV=development
PORT=3000

# Nacos 配置中心
NACOS_HOST=localhost
NACOS_PORT=8848
NACOS_TIMEOUT=3000

# Redis 配置 (用于限流和缓存)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 服务发现配置
SERVICE_DISCOVERY_TYPE=nacos

# 缓存配置
CACHE_TTL=5000

# 代理配置
PROXY_TIMEOUT=10000

# 限流配置
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# 熔断器配置
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# 健康检查配置
HEALTH_CHECK_INTERVAL=10000
