{
  "name": "@req2task/service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "start:infra": "docker-compose -f ../../docker-compose.dev.yml up -d",
    "stop:infra": "docker-compose -f ../../docker-compose.dev.yml down",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "pnpm build && ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d ./dist/src/data-source.js ",
    "migration:run": "pnpm build && pnpm typeorm migration:run -d ./dist/src/data-source.js",
    "migration:drop": "pnpm build && pnpm typeorm schema:drop -d ./dist/src/data-source.js",
    "migration:revert": "pnpm typeorm migration:revert -d ./dist/src/data-source.js",
    "migration:show": "pnpm typeorm migration:show -d ./dist/src/data-source.js",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "rebuild:vector": "ts-node -r tsconfig-paths/register src/rebuild-vector.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/lib-storage": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.4.22",
    "@req2task/core": "workspace:^",
    "@req2task/dto": "workspace:^",
    "axios": "catalog:",
    "bcryptjs": "^3.0.3",
    "chromadb-default-embed": "^2.14.0",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "dotenv": "catalog:",
    "install": "^0.13.0",
    "ip": "^2.0.1",
    "mammoth": "catalog:",
    "nestjs-command": "^3.1.4",
    "ollama": "catalog:",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "socket.io": "^4.8.3",
    "json-stream-handler": "^0.1.0",
    "typeorm": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/ip": "^1.1.3",
    "@types/jest": "^29.5.11",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "catalog:",
    "jest": "catalog:",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "catalog:",
    "ts-loader": "^9.5.1",
    "ts-node": "catalog:",
    "tsconfig-paths": "catalog:",
    "typescript": "catalog:"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@req2task/core$": "<rootDir>/../../../packages/core/src",
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
