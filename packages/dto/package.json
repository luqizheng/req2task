{
  "name": "@req2task/dto",
  "version": "0.1.0",
  "private": true,
  "description": "Shared DTOs for req2task web and service",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && api-extractor run --local",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "class-transformer": "catalog:",
    "class-validator": "catalog:"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.5",
    "@req2task/dev-config": "workspace:^",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
